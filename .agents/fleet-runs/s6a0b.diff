+package com.sherifradwan.ancnative.ui.components
+
+import com.sherifradwan.ancnative.R
+import com.sherifradwan.ancnative.state.RegistrationStep
+import com.sherifradwan.ancnative.state.StepStatus
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotEquals
+import org.junit.Test
+
+class RegistrationStepTextTest {
+    @Test
+    fun five_steps_have_five_distinct_title_resources() {
+        val titles = RegistrationStep.entries.map { it.titleRes() }
+        assertEquals(RegistrationStep.entries.size, titles.toSet().size)
+    }
+
+    @Test
+    fun obstetric_and_pregnancy_titles_reuse_the_existing_strings() {
+        assertEquals(R.string.obstetric_risk_section_title, RegistrationStep.OBSTETRIC.titleRes())
+        assertEquals(R.string.previous_pregnancies, RegistrationStep.PREGNANCIES.titleRes())
+        assertNotEquals(R.string.previous_pregnancies, RegistrationStep.HISTORIES.titleRes())
+    }
+
+    @Test
+    fun three_statuses_have_distinct_words_and_the_done_word_is_reused() {
+        val words = StepStatus.entries.map { it.labelRes() }
+        assertEquals(StepStatus.entries.size, words.toSet().size)
+        assertEquals(R.string.done, StepStatus.DONE.labelRes())
+    }
+
+    @Test
+    fun three_statuses_have_distinct_nonblank_glyphs() {
+        val glyphs = StepStatus.entries.map { it.glyph() }
+        assertEquals(StepStatus.entries.size, glyphs.toSet().size)
+        glyphs.forEach { assertNotEquals("", it.trim()) }
+        assertEquals("✓", StepStatus.DONE.glyph())
+    }
+}
