{
  "_comment": "Copy of skills template shape (~/skills/multi-agent-collaborative-audit/resources/templates/TEST_MANIFEST.template.json). One entry per test. deps = globs of every file whose change could alter the result (code under test, the test itself). Round-1 oracles P1-P10 from .agents/pipeline/SPEC_FIX.md; round-2 oracles Q1-Q7 and U1-U6 from .agents/pipeline/SPEC_FIX_R2.md. Tier 1 = fast local (unit/static), tier 2 = build gate. R2: 'always' flags removed from all tier-1 entries (run on dep change); deps made precise to the exercised production file(s) plus the test file itself.",
  "tests": [
    {
      "id": "UNIT-parse",
      "tier": 1,
      "cmd": "./gradlew --offline :app:testDebugUnitTest --tests 'com.sherifradwan.ancnative.ui.ParseDeliveryNotesSpecTest'",
      "deps": [
        "app/src/main/**/ui/DeliveryNotesParser.kt",
        "app/src/test/**/ParseDeliveryNotesSpecTest.kt"
      ],
      "covers": ["P1", "P2", "P3", "P4", "P5", "Q1", "Q2", "Q3", "Q4"]
    },
    {
      "id": "UNIT-parse-legacy",
      "tier": 1,
      "cmd": "./gradlew --offline :app:testDebugUnitTest --tests '*DeliveryNotesParserTest'",
      "deps": [
        "app/src/main/**/ui/DeliveryNotesParser.kt",
        "app/src/test/**/DeliveryNotesParserTest.kt"
      ],
      "covers": ["P5", "Q4"]
    },
    {
      "id": "UNIT-format",
