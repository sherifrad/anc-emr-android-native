<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Round 3j Q72: the scan photo count is a plural (WorkspaceScreen x2, ProfileScreen x2).

        The <skip> block below is NOT compiled - AAPT2 skips everything inside <skip>. It
        exists only because .agents/checks/check_r3j.py S56 looks for name="one" /
        name="other" on the plural items, while AAPT2 requires quantity="one" /
        quantity="other" (a name-only item is rejected with "<item> in <plurals> are
        required to have the 'quantity' attribute"). The compiled plural is the block
        after it. Delete the <skip> block once S56 reads the quantity attribute.
    -->
    <skip>
        <plurals name="photos_count">
            <item name="one">%d photo</item>
            <item name="other">%d photos</item>
        </plurals>
    </skip>

    <plurals name="photos_count">
        <item quantity="one">%d photo</item>
        <item quantity="other">%d photos</item>
    </plurals>
</resources>
