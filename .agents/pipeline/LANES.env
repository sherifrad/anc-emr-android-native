# MACA fleet, reorganised again 2026-10-31 (Antigravity back). Source: `source .agents/pipeline/LANES.env` before run_pipeline.py.
# Evidence (one-line tool probes, no benchmarks):
#  Antigravity (agy): the DEFAULT model (Gemini 4 Argon) is quota-exhausted (429, resets ~29 h after 2026-10-31 02:00) but named models work:
#    claude-sonnet-5-5-medium 5 s, claude-opus-5-5-medium 9 s, gpt-oss-120b-medium 6 s, gemini-3.8-flash-medium 25-32 s; all read the repo correctly; Sonnet and Gemini wrote a file.
#    Writing needs `--mode accept-edits` (owner approved 2026-10-31; set in agy-delegate/scripts/relay.mjs; NOT --dangerously-skip-permissions). ALWAYS name a model (agy:<model>).
#  opencode free: glm-5.3-flash-free 4 s, deepseek-v4.1-flash-free 6 s, mimo 10 s, big-pickle 15 s - but the free quota is SHARED and lasts about one round.
#  Not usable: openai/gpt-6-luna (plan limit), OmniRoute: github/gh (banned), qoder/if (quota), cl/cline free (timeouts), mc/muse (billing), ddgw (429), grok-cli (never exits), cfp (text only), aihorde (never send anything).
# Staffing rule: builder and reviewers from different vendors where possible; reviewers are read-only.
export MACA_LANE_TESTS=opencode:opencode/glm-5.3-flash-free
export MACA_LANE_CORE=agy:claude-sonnet-5-5-medium
export MACA_LANE_UI=agy:claude-sonnet-5-5-medium
export MACA_REVIEW_LANES=agy:claude-opus-5-5-medium,agy:gemini-3.8-flash-medium
# fallback chain, tried in order when a lane returns nothing or changes nothing (the failing lane itself is skipped)
export MACA_FALLBACK_LANES=agy:gemini-3.8-flash-medium,opencode:opencode/deepseek-v4.1-flash-free,claude:claude-sonnet-5-5
export MACA_RELAY_TIMEOUT_MS=900000
