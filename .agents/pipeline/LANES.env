# MACA lane regulation, 2026-10-30. Source: `source .agents/pipeline/LANES.env` before run_pipeline.py.
# Evidence = real runs plus one-line probes (no benchmarks, free quota is scarce).
#  Editors that really change files: Claude Sonnet 5.5 (all rounds), Grok 4.7 via grok-cli (wrote a file, but the process did not exit: needs a timeout).
#  openai/gpt-6-luna (ChatGPT plan): "The usage limit has been reached" -> every dispatch failed instantly. Put back first when the plan resets.
#  Read-only text answers work, tool use does not (printed the call or stopped): cfp/deepseek-v4-pro-0813, cfp/kimi-k2.7-code, cfp/glm-5.2 -> reviewers only.
#  Unusable now: ddgw (429 conversation limit), cxa (Codex app-server not configured), zc (zcode CLI missing), dva (DEVIN_AGENTIC_HOME), aug (auggie not installed),
#  kmc (no Kimi Code subscription / banned), nvidia kimi-k3 and deepseek (410 model shut down), aihorde (community nodes: never send anything from this project).
export MACA_LANE_TESTS=claude:claude-sonnet-5-5
export MACA_LANE_CORE=claude:claude-sonnet-5-5
export MACA_LANE_UI=claude:claude-sonnet-5-5
export MACA_REVIEW_LANES=claude:claude-sonnet-5-5,opencode:omniroute/cfp/deepseek-ai/deepseek-v4-pro-0813
export MACA_FALLBACK_LANES=opencode:openai/gpt-6-luna   # Grok 4.7 removed: it edits but its process never exits (22 min hang on 2026-10-30)
export MACA_RELAY_TIMEOUT_MS=900000
