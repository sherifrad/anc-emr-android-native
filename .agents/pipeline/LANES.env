# MACA fleet, reorganised 2026-10-31. Source: `source .agents/pipeline/LANES.env` before run_pipeline.py.
# Evidence = real runs (R2: GLM good at tests/review, DeepSeek good at building) + one-line tool probes on 2026-10-31
# (create hello.txt): opencode/glm-5.3-flash-free 4 s, opencode/deepseek-v4.1-flash-free 6 s, opencode/mimo-v2.6-flash-free 10 s, opencode/big-pickle 15 s - all wrote the file.
# NOTE: the opencode free quota is SHARED by all opencode free models and resets; parallel opencode sessions stall - the pipeline runs lanes one at a time.
# Unavailable now: openai/gpt-6-luna (ChatGPT plan "usage limit reached"), agy/Antigravity (429, resets ~31 h after 2026-10-31 01:00), OmniRoute: github/gh (banned/unlicensed),
#  qoder/if (quota exhausted), cxa/zc/dva/aug (bridge not set up), kmc (no subscription), mc/muse (billing), cline/cl free models (60 s timeouts or empty), ddgw (429), grok-cli (process never exits),
#  cfp (answers text, does not run tools). aihorde: community nodes, never send anything from this project.
export MACA_LANE_TESTS=opencode:opencode/glm-5.3-flash-free
export MACA_LANE_CORE=opencode:opencode/deepseek-v4.1-flash-free
export MACA_LANE_UI=opencode:opencode/deepseek-v4.1-flash-free
export MACA_REVIEW_LANES=opencode:opencode/glm-5.3-flash-free,claude:claude-sonnet-5-5
# fallback chain, tried in order when a lane returns nothing or changes nothing (a lane equal to the failing one is skipped)
export MACA_FALLBACK_LANES=claude:claude-sonnet-5-5,opencode:opencode/big-pickle
export MACA_RELAY_TIMEOUT_MS=900000
# when GPT-6 Luna's plan resets, put opencode:openai/gpt-6-luna back as MACA_LANE_CORE (it was the fastest builder, 29 s on round 2c).
