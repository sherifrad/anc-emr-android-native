class OwnerFixesUiTest {
    @get:Rule
    val compose = createAndroidComposeRule<MainActivity>()

    private val events = mutableListOf<AncEvent>()

    private fun show(patient: DemoPatient) {
        compose.activity.runOnUiThread {
            compose.activity.setContent {
                AncTheme {
                    Box(Modifier.width(360.dp)) {
                        OverviewTab(
                            patient = patient,
                            canEdit = true,
                            onEvent = {},
                            onAddAttachment = {},
                            onViewAttachment = {},
                        )
                    }
                }
            }
        }
        compose.waitForIdle()
    }

    private fun showList(patients: List<DemoPatient>) {
        compose.activity.runOnUiThread {
            compose.activity.setContent {
                AncTheme {
                    PatientListScreen(
                        state = AncState(
                            patients = patients,
                            vaultState = VaultState.Unlocked(sessionEpoch = 1L),
                            route = AncRoute.PatientList,
                        ),
                        onEvent = { events += it },
                    )
                }
            }
        }
        compose.waitForIdle()
    }

