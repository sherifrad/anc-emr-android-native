    @Test
    fun f1_visits_limit_uses_parsed_date() {
        val visits = listOf(
            visit(0).copy(id = "v-iso-jan", date = "2026-01-10"),
            visit(1).copy(id = "v-not-iso", date = "12/03/2026"),
            visit(2).copy(id = "v-iso-feb", date = "2026-02-01"),
        )
        val result = reportVisits(patient(visits), 2)
        assertEquals(listOf("v-iso-feb", "v-not-iso"), result.rows.map { it.id })
        assertEquals(1, result.hidden)
    }

    @Test
    fun f1_labs_limit_uses_parsed_date() {
        val labs = listOf(
            lab(0).copy(id = "l-iso-jan", date = "2026-01-10"),
            lab(1).copy(id = "l-blank", date = ""),
            lab(2).copy(id = "l-iso-feb", date = "2026-02-01"),
        )
        val result = reportLabs(patient().copy(labInvestigations = labs), 2)
        assertEquals(listOf("l-blank", "l-iso-feb"), result.rows.map { it.id })
        assertEquals(1, result.hidden)
    }

    @Test
    fun f1_blank_medication_start_date_sorts_first_in_current_list() {
        val meds = listOf(
            medication(id = "m-iso", name = "Iron", status = "Active", startDate = "2026-02-01"),
            medication(id = "m-blank", name = "Calcium", status = "Active", startDate = ""),
