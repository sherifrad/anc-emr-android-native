-    medications.filter { isOngoingMedication(it.status, it.isNonCompliant) }.mapTo(HashSet()) { medicationNameKey(it.name) }
+/** Keys (name plus route) of the drugs this patient takes now. A tile with one of these must not start a second prescription. */
+fun activeMedicationNameKeys(medications: List<DemoMedicationRecord>): Set<String> =
+    medications.filter { isOngoingMedication(it.status, it.isNonCompliant) }.mapTo(HashSet()) { medicationActiveKey(it.name, it.route) }
 
-fun MedicationTile.isAlreadyActive(activeNameKeys: Set<String>): Boolean = medicationNameKey(name) in activeNameKeys
+fun MedicationTile.isAlreadyActive(activeNameKeys: Set<String>): Boolean = medicationActiveKey(name, route) in activeNameKeys
 
