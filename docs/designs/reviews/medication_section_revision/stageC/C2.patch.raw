+    @Test
+    fun alreadyActiveKeysOnNamePlusRouteSoADifferentRouteIsADifferentDrug() {
+        val meds = listOf(
+            medRecord("Ferrous Sulfate", "Active", route = "Oral"),
+            medRecord("Zinc", "Active", nonCompliant = true, route = " Oral "),
+            medRecord("Aspirin", "Discontinued"),
+        )
+        val active = activeMedicationNameKeys(meds)
+        assertTrue(MedicationTile("1", " ferrous SULFATE ", "200 mg", " oral ", "Once daily").isAlreadyActive(active))
+        assertTrue("non-compliant ongoing counts as before", MedicationTile("2", "Zinc", "", "oral", "").isAlreadyActive(active))
+        assertFalse("a different route is a separate drug", MedicationTile("3", "Ferrous Sulfate", "200 mg", "Intramuscular", "Once daily").isAlreadyActive(active))
+        assertFalse("a stopped drug does not count", MedicationTile("4", "Aspirin", "75 mg", "Oral", "Once daily").isAlreadyActive(active))
+    }
