/**
 * The one rule for "the same drug name" in the picker: trimmed and without case, the way a save stores the name
 * (trimmed). Recent uses it, and the already-active check builds its name plus route key on it.
 */
fun medicationNameKey(name: String): String = name.trim().lowercase()

/**
 * The already-active key: the [medicationNameKey] of the name and of the route joined by a pipe, so a name can
 * never bleed into the route. A different route is a different drug, so a patient on oral ferrous sulfate can
 * still open the intramuscular iron tile.
 */
fun medicationNameRouteKey(name: String, route: String): String = "${medicationNameKey(name)}|${medicationNameKey(route)}"
