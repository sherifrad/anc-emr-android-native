    @Test
    fun theAlreadyActiveCheckMatchesNameAndRouteTogether() {
        val meds = listOf(
            medRecord("Ferrous Sulfate", "Active"),
            medRecord("Aspirin", "Discontinued"),
            medRecord("Labetalol", "Active", nonCompliant = true),
        )
        val active = activeMedicationKeys(meds)
        assertEquals(setOf("ferrous sulfate|oral", "labetalol|oral"), active)

        assertTrue("same name and route", MedicationTile("1", " Ferrous SULFATE ", "200 mg", " Oral ", "Once daily").isAlreadyActiveOnRoute(active))
        assertFalse("same name, other route is a different drug", MedicationTile("2", "ferrous sulfate", "100 mg", "Intramuscular", "Once daily").isAlreadyActiveOnRoute(active))
        assertFalse("stopped does not count on any route", MedicationTile("3", "Aspirin", "75 mg", "Oral", "Once daily").isAlreadyActiveOnRoute(active))
        assertFalse(MedicationTile("4", "Aspirin", "75 mg", "Intramuscular", "Once daily").isAlreadyActiveOnRoute(active))
        assertTrue("non-compliant is still active", MedicationTile("5", "labetalol", "", "oral", "").isAlreadyActiveOnRoute(active))
        assertEquals("ferrous sulfate|oral", medicationNameRouteKey("\tFerrous sulfate ", " ORAL "))

        // With both routes on the list, each tile blocks only its own route.
        val bothRoutes = activeMedicationKeys(
            listOf(
                medRecord("Ferrous Sulfate", "Active"),
                medRecord("Ferrous Sulfate", "Active", route = "Intramuscular"),
            ),
        )
        assertTrue(MedicationTile("6", "Ferrous Sulfate", "200 mg", "Oral", "Once daily").isAlreadyActiveOnRoute(bothRoutes))
        assertTrue(MedicationTile("7", "Ferrous Sulfate", "100 mg", "Intramuscular", "Once daily").isAlreadyActiveOnRoute(bothRoutes))
        assertFalse(MedicationTile("8", "Ferrous Sulfate", "200 mg", "Subcutaneous", "Once daily").isAlreadyActiveOnRoute(bothRoutes))
    }
}
