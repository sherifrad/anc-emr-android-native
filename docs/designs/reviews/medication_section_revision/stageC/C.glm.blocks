    @Test
    fun patientHub_tabNavigation_switchesTabs() {
        showHub(WorkspaceSection.EPISODE_OVERVIEW)

        listOf(PatientHubTab.VISITS, PatientHubTab.LABS, PatientHubTab.MEDS, PatientHubTab.PLAN).forEach { tab ->
            compose.openHubTab(tab)
            compose.onNodeWithTag(tab.contentTag()).assertIsDisplayed()
        }
    }

    @Test
    fun patientHub_header_largeFont_showsFullIdentityWithoutClipping() {
        // 360dp width comes from the all-tests device fixture; font scale is forced in the density
        val longName = "Amina Abdulrahman Ogunbanjo Adeyemi"
        val state = AncState(
            patients = listOf(patient.copy(displayName = longName)),
            vaultState = VaultState.Unlocked(sessionEpoch = 7001L),
        )
        compose.activity.runOnUiThread {
            compose.activity.setContent {
                AncTheme {
                    CompositionLocalProvider(
                        LocalDensity provides LocalDensity.current.copy(fontScale = 2f),
                    ) {
                        PatientHubScreen(
                            state = state,
                            route = AncRoute.Workspace(patient.id, WorkspaceSection.EPISODE_OVERVIEW),
                            onEvent = {},
                            onStartVisit = { _, _ -> },
                        )
                    }
                }
            }
        }
        compose.waitForIdle()

        compose.onNodeWithTag("hubPatientName").assertIsDisplayed()
        val nameLayout = compose.onNodeWithTag("hubPatientName").fetchTextLayoutResult()
        assertTrue(nameLayout.lineCount <= 2)
        assertFalse(nameLayout.hasVisualOverflow)

        listOf("hubGaBadge", "hubRiskBadge", "hubAllergyText").forEach { tag ->
            compose.onNodeWithTag(tag).assertIsDisplayed()
            val layout = compose.onNodeWithTag(tag).fetchTextLayoutResult()
            assertFalse(layout.hasVisualOverflow)
        }
    }
}
