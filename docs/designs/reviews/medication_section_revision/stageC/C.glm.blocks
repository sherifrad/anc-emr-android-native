    private fun showHub(section: WorkspaceSection, fontScale: Float = 1f) {
        val state = AncState(
            patients = listOf(patient),
            vaultState = VaultState.Unlocked(sessionEpoch = 7001L),
        )
        compose.activity.runOnUiThread {
            compose.activity.setContent {
                AncTheme {
                    CompositionLocalProvider(
                        LocalDensity provides LocalDensity.current.copy(fontScale = fontScale),
                    ) {
                        PatientHubScreen(
                            state = state,
                            route = AncRoute.Workspace(patient.id, section),
                            onEvent = {},
                            onStartVisit = { _, _ -> },
                        )
                    }
                }
            }
        }
        compose.waitForIdle()
    }
