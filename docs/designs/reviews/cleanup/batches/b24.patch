+@Composable
+fun BatchInfoBar(
+    dateText: String,
+    gaText: String?,
+    labName: String?,
+    onChangeClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    tag: String? = null,
+) {
+    Card(
+        modifier = modifier
+            .fillMaxWidth()
+            .clickable(onClick = onChangeClick)
+            .let { if (tag != null) it.testTag(tag) else it },
