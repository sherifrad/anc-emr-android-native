+++ b/app/src/main/java/com/sherifradwan/ancnative/storage/Hashing.kt
@@ -0,0 +1,22 @@
+package com.sherifradwan.ancnative.storage
+
+import java.io.InputStream
+import java.security.MessageDigest
+
+internal fun ByteArray.toHexLower(): String = joinToString("") { "%02x".format(it) }
+
+internal fun sha256Hex(bytes: ByteArray): String =
+    MessageDigest.getInstance("SHA-256").digest(bytes).toHexLower()
+
+internal fun sha256Hex(text: String): String = sha256Hex(text.toByteArray(Charsets.UTF_8))
+
+/** Reads the stream to its end; the caller closes it. */
+internal fun sha256Hex(input: InputStream): String {
+    val digest = MessageDigest.getInstance("SHA-256")
+    val buffer = ByteArray(8192)
+    var read: Int
+    while (input.read(buffer).also { read = it } != -1) {
+        digest.update(buffer, 0, read)
+    }
+    return digest.digest().toHexLower()
+}
diff --git a/app/src/main/java/com/sherifradwan/ancnative/storage/LabBatchCommands.kt b/app/src/main/java/com/sherifradwan/ancnative/storage/LabBatchCommands.kt
new file mode 100644
index 0000000..e9b6df5
--- /dev/null
+++ b/app/src/main/java/com/sherifradwan/ancnative/storage/LabBatchCommands.kt
@@ -0,0 +1,150 @@
+package com.sherifradwan.ancnative.storage
+
+import com.sherifradwan.ancnative.model.ClinicalVocabulary
+import com.sherifradwan.ancnative.state.AncRoute
+import com.sherifradwan.ancnative.state.SavedNotice
+import com.sherifradwan.ancnative.state.WorkspaceSection
+import java.util.UUID
+
+/** A batch is one save: enough entries for a booking panel, small enough to stay in one draft row. */
+const val MAX_LAB_BATCH_ENTRIES = 60
+
+/** One result inside a batch. `labId` is generated by the caller so the same list can be retried. */
+data class LabBatchEntry(
+    val labId: String,
+    val testName: String,
+    val testCategory: String,
+    val result: String,
+    val unit: String? = null,
+    val referenceRange: String? = null,
+    val isAbnormal: Boolean = false,
+    val notes: String? = null,
+) {
+    /** The exact fields that are written to the row, in a stable order. */
+    fun canonical(date: String, labName: String?): String =
+        "$labId|$date|$testCategory|$testName|$result|$unit|$referenceRange|$isAbnormal|$notes|$labName"
+}
+
+/** What the batch undo carries: the rows as they were committed, so a mismatch aborts the whole action. */
+data class LabBatchRecordRef(
+    val labId: String,
+    val revision: Long,
+    val contentHash: String,
+)
+
+fun labBatchEntryHash(entry: LabBatchEntry, date: String, labName: String?): String =
+    sha256Hex(entry.canonical(date, labName))
+
+private fun batchIsUuid(raw: String): Boolean = runCatching { UUID.fromString(raw) }.isSuccess
+
+private fun List<LabBatchEntry>.structurallyValid(): Boolean =
+    isNotEmpty() && size <= MAX_LAB_BATCH_ENTRIES &&
+        map { it.labId }.toSet().size == size &&
+        all { entry ->
+            entry.labId.isNotBlank() &&
+                entry.testName.isNotBlank() &&
+                entry.result.isNotBlank() &&
+                entry.testCategory in ClinicalVocabulary.testCategories
+        }
+
+/**
+ * Inserts a whole laboratory batch in one transaction and writes one receipt for it.
+ * `recordId` is the batch id (this command's operation id): no row carries it, which is why the batch is only
+ * addressable while the caller still holds the entries.
+ */
+data class SaveLabBatchCommand(
+    override val editorSessionId: String = "",
+    override val operationUuid: String,
+    override val patientId: String,
+    override val expectedPatientRevision: Long,
+    val date: String,
+    val labName: String?,
+    val entries: List<LabBatchEntry>,
+) : ClinicalCommand {
+    override val recordKind = ClinicalRecordKind.LAB_BATCH_SAVE
+    override val recordId get() = operationUuid
+
+    override fun destination(): AncRoute = AncRoute.Workspace(patientId, WorkspaceSection.LABORATORY)
+    override fun savedNotice(): SavedNotice = SavedNotice.LABORATORY
+
+    override fun isStructurallyValid(): Boolean =
+        batchIsUuid(operationUuid) &&
+            patientId.isNotBlank() &&
+            expectedPatientRevision >= 1 &&
+            date.isNotBlank() &&
+            ClinicalVocabulary.isValidIsoDate(date) &&
+            entries.structurallyValid()
+
+    override fun computeFingerprint(): String = sha256Hex(
+        "LAB_BATCH_SAVE|$operationUuid|$patientId|$expectedPatientRevision|$date|$labName|" +
+            entries.joinToString(";") { it.canonical(date, labName) },
+    )
+}
+
+/** Deletes every row of a committed batch, all or nothing. */
+data class DeleteLabBatchCommand(
+    override val editorSessionId: String = "",
+    override val operationUuid: String,
+    override val patientId: String,
+    override val expectedPatientRevision: Long,
+    val batchId: String,
+    val refs: List<LabBatchRecordRef>,
+) : ClinicalCommand {
+    override val recordKind = ClinicalRecordKind.LAB_BATCH_DELETE
+    override val recordId get() = batchId
+
+    override fun destination(): AncRoute = AncRoute.Workspace(patientId, WorkspaceSection.LABORATORY)
+    override fun savedNotice(): SavedNotice = SavedNotice.LABORATORY
+
+    override fun isStructurallyValid(): Boolean =
+        batchIsUuid(operationUuid) &&
+            batchIsUuid(batchId) &&
+            patientId.isNotBlank() &&
+            expectedPatientRevision >= 1 &&
+            refs.isNotEmpty() &&
+            refs.size <= MAX_LAB_BATCH_ENTRIES &&
+            refs.map { it.labId }.toSet().size == refs.size &&
+            refs.all { it.labId.isNotBlank() && it.revision >= 1 && it.contentHash.isNotBlank() }
+
+    override fun computeFingerprint(): String = sha256Hex(
+        "LAB_BATCH_DELETE|$operationUuid|$patientId|$expectedPatientRevision|$batchId|" +
+            refs.joinToString(";") { "${it.labId}:${it.revision}:${it.contentHash}" },
+    )
+}
+
+/**
+ * Puts the same rows back at the delete receipt's tombstone + 1, all or nothing. The revision is not a parameter:
+ * it is read from [deleteOperationUuid]'s receipt, so it cannot disagree with what the delete committed.
+ */
+data class RestoreLabBatchCommand(
+    override val editorSessionId: String = "",
+    override val operationUuid: String,
+    override val patientId: String,
+    override val expectedPatientRevision: Long,
+    val batchId: String,
+    val date: String,
+    val labName: String?,
+    val entries: List<LabBatchEntry>,
+    val deleteOperationUuid: String,
+) : ClinicalCommand {
+    override val recordKind = ClinicalRecordKind.LAB_BATCH_RESTORE
+    override val recordId get() = batchId
+
+    override fun destination(): AncRoute = AncRoute.Workspace(patientId, WorkspaceSection.LABORATORY)
+    override fun savedNotice(): SavedNotice = SavedNotice.LABORATORY
+
+    override fun isStructurallyValid(): Boolean =
+        batchIsUuid(operationUuid) &&
+            batchIsUuid(batchId) &&
+            patientId.isNotBlank() &&
+            expectedPatientRevision >= 1 &&
+            batchIsUuid(deleteOperationUuid) &&
+            date.isNotBlank() &&
+            ClinicalVocabulary.isValidIsoDate(date) &&
+            entries.structurallyValid()
+
+    override fun computeFingerprint(): String = sha256Hex(
+        "LAB_BATCH_RESTORE|$operationUuid|$patientId|$expectedPatientRevision|$batchId|$date|$labName|$deleteOperationUuid|" +
+            entries.joinToString(";") { it.canonical(date, labName) },
+    )
+}
