package com.sherifradwan.ancnative

import androidx.activity.compose.setContent
import androidx.compose.foundation.layout.Box
import androidx.compose.foundation.layout.widthIn
import androidx.compose.runtime.CompositionLocalProvider
import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.setValue
import androidx.compose.ui.Modifier
import androidx.compose.ui.platform.LocalDensity
import androidx.compose.ui.test.assertDoesNotExist
import androidx.compose.ui.test.assertExists
import androidx.compose.ui.test.assertIsDisplayed
import androidx.compose.ui.test.assertIsEnabled
import androidx.compose.ui.test.assertIsNotEnabled
import androidx.compose.ui.test.assertTextContains
import androidx.compose.ui.test.assertTextEquals
import androidx.compose.ui.test.hasAnyAncestor
import androidx.compose.ui.test.hasTestTag
import androidx.compose.ui.test.hasText
import androidx.compose.ui.test.junit4.createAndroidComposeRule
import androidx.compose.ui.test.onNodeWithTag
import androidx.compose.ui.test.onNodeWithText
import androidx.compose.ui.test.performClick
import androidx.compose.ui.test.performScrollTo
import androidx.compose.ui.test.performTextReplacement
import androidx.compose.ui.unit.Density
import androidx.compose.ui.unit.dp
import androidx.test.ext.junit.runners.AndroidJUnit4
import com.sherifradwan.ancnative.model.DemoFixtures
import com.sherifradwan.ancnative.model.DemoPatient
import com.sherifradwan.ancnative.state.AncEvent
import com.sherifradwan.ancnative.state.AncReducer
import com.sherifradwan.ancnative.state.AncRoute
import com.sherifradwan.ancnative.state.AncState
import com.sherifradwan.ancnative.state.SavePhase
import com.sherifradwan.ancnative.state.SaveUiError
import com.sherifradwan.ancnative.state.WorkspaceSection
import com.sherifradwan.ancnative.ui.AncApp
import com.sherifradwan.ancnative.ui.AncTheme
import org.junit.Assert.assertEquals
import org.junit.Assert.assertNull
import org.junit.Assert.assertTrue
import org.junit.Rule
import org.junit.Test
import org.junit.runner.RunWith

/**
 * The delivery plan sheet, mounted through the real AncApp and the reducer. The store is faked by the test: on
 * SubmitPatientProfile it commits a composed note, holds the save, or fails it.
 */
@RunWith(AndroidJUnit4::class)
class DeliveryPlanSheetTest {
    @get:Rule
    val compose = createAndroidComposeRule<MainActivity>()

    private enum class SaveMode { COMMIT, HOLD, FAIL }

    private val heuristicPatient = DemoFixtures.patients.first().copy(
        status = "active",
        obstetricNotes = "Agreed Delivery Hospital: Al Salam\nFees: 5000 EGP",
    )
    private val composedPatient = DemoFixtures.patients.first().copy(
        status = "active",
        obstetricNotes = "Agreed Delivery Hospital: Al Salam\nAgreed Delivery Fees: 5000 EGP",
    )

    private var patient: DemoPatient = heuristicPatient
    private var saveMode = SaveMode.COMMIT
    private var state by mutableStateOf(workspace(heuristicPatient))

    private val LABEL_HOSPITAL get() = compose.activity.getString(R.string.delivery_hospital_title)
    private val LABEL_FEES get() = compose.activity.getString(R.string.delivery_fees_title)
    private val LABEL_PLAN get() = compose.activity.getString(R.string.delivery_plan_title)
    private val LABEL_POSTPARTUM get() = compose.activity.getString(R.string.delivery_postpartum_title)

    private fun workspace(p: DemoPatient) =
        AncState(patients = listOf(p), route = AncRoute.Workspace(p.id, WorkspaceSection.PLAN))

    private fun onEvent(event: AncEvent) {
        state = AncReducer.reduce(state, event)
        if (event == AncEvent.SubmitPatientProfile) {
            when (saveMode) {
                SaveMode.COMMIT -> commit()
                SaveMode.HOLD -> Unit
                SaveMode.FAIL -> state = state.copy(savePhase = SavePhase.ERROR, saveError = SaveUiError.Unknown)
            }
        }
    }

    private fun commit() {
        val values = state.patientDraft?.deliveryPlan ?: return
        val notes = buildString {
            append("Agreed Delivery Hospital: ").append(values.hospital.trim())
            append('\n').append("Agreed Delivery Fees: ").append(values.fees.trim())
            append('\n').append("Delivery Plan: ").append(values.plan.trim())
            append('\n').append("Postpartum Note: ").append(values.postpartum.trim())
        }
        state = state.copy(
            patients = state.patients.map { if (it.id == patient.id) it.copy(obstetricNotes = notes) else it },
            patientDraft = null,
            savePhase = SavePhase.IDLE,
            saveError = null,
        )
    }

    private fun start(p: DemoPatient, fontScale: Float = 1f) {
        patient = p
        state = workspace(p)
        compose.activity.setContent {
            AncTheme {
                CompositionLocalProvider(LocalDensity provides Density(LocalDensity.current.density, fontScale)) {
                    Box(Modifier.widthIn(max = if (fontScale > 1f) 360.dp else 1440.dp)) {
                        AncApp(state = state, onEvent = ::onEvent)
                    }
                }
            }
        }
        compose.waitForIdle()
    }

    private fun openSheet() {
        compose.onNodeWithTag("editDeliveryPlan").performClick()
        compose.waitForIdle()
    }

    private fun type(tag: String, text: String) {
        compose.onNodeWithTag(tag).performScrollTo().performTextReplacement(text)
        compose.waitForIdle()
    }

    private fun inSheet(text: String) =
        compose.onNode(hasText(text) and hasAnyAncestor(hasTestTag("deliveryPlanSheet")))

    @Test
    fun edit_opens_the_sheet_and_stays_on_the_plan_tab() {
        start(heuristicPatient)
        openSheet()
        compose.onNodeWithTag("deliveryPlanSheet").assertExists()
        compose.onNodeWithTag("planTabContent").assertExists()
        assertEquals(AncRoute.Workspace(patient.id, WorkspaceSection.PLAN), state.route)
    }

    @Test
    fun notice_shows_for_hand_typed_notes_and_not_for_composed_notes() {
        start(heuristicPatient)
        openSheet()
        compose.onNodeWithTag("deliveryPlanRewriteNotice").assertIsDisplayed()
        compose.onNodeWithTag("cancelDeliveryPlan").performClick()
        compose.waitForIdle()
        compose.onNodeWithTag("deliveryPlanSheet").assertDoesNotExist()

        start(composedPatient)
        openSheet()
        compose.onNodeWithTag("deliveryPlanRewriteNotice").assertDoesNotExist()
    }

    @Test
    fun editing_fees_and_saving_updates_the_card_and_keeps_the_plan_tab() {
        start(heuristicPatient)
        openSheet()
        type("deliveryPlanFeesField", "7000 EGP")
        compose.onNodeWithTag("saveDeliveryPlan").performClick()
        compose.waitForIdle()
        compose.onNodeWithTag("deliveryPlanSheet").assertDoesNotExist()
        compose.onNodeWithText("7000 EGP", substring = true).assertIsDisplayed()
        assertEquals(AncRoute.Workspace(patient.id, WorkspaceSection.PLAN), state.route)
        assertNull(state.patientDraft)
    }

    @Test
    fun untouched_cancel_closes_at_once() {
        start(heuristicPatient)
        openSheet()
        compose.onNodeWithTag("cancelDeliveryPlan").performClick()
        compose.waitForIdle()
        compose.onNodeWithTag("deliveryPlanSheet").assertDoesNotExist()
        compose.onNodeWithTag("deliveryPlanDiscardDialog").assertDoesNotExist()
    }

    @Test
    fun touched_cancel_asks_keep_stays_and_discard_leaves_the_card_unchanged() {
        start(heuristicPatient)
        openSheet()
        type("deliveryPlanFeesField", "9000 EGP")
        compose.onNodeWithTag("cancelDeliveryPlan").performClick()
        compose.waitForIdle()
        compose.onNodeWithTag("deliveryPlanDiscardDialog").assertIsDisplayed()

        compose.onNodeWithTag("deliveryPlanDiscardKeep").performClick()
        compose.waitForIdle()
        compose.onNodeWithTag("deliveryPlanDiscardDialog").assertDoesNotExist()
        compose.onNodeWithTag("deliveryPlanSheet").assertIsDisplayed()

        compose.onNodeWithTag("cancelDeliveryPlan").performClick()
        compose.waitForIdle()
        compose.onNodeWithTag("deliveryPlanDiscardConfirm").performClick()
        compose.waitForIdle()
        compose.onNodeWithTag("deliveryPlanSheet").assertDoesNotExist()
        assertEquals(heuristicPatient.obstetricNotes, state.patients.first().obstetricNotes)
    }

    @Test
    fun save_disabled_until_a_field_changes() {
        start(heuristicPatient)
        openSheet()
        compose.onNodeWithTag("saveDeliveryPlan").assertIsNotEnabled()
        type("deliveryPlanPlanField", "Review at 38 weeks")
        compose.onNodeWithTag("saveDeliveryPlan").assertIsEnabled()
    }

    @Test
    fun delayed_save_disables_fields_and_buttons_and_shows_the_spinner() {
        saveMode = SaveMode.HOLD
        start(heuristicPatient)
        openSheet()
        type("deliveryPlanPlanField", "Review at 38 weeks")
        compose.onNodeWithTag("saveDeliveryPlan").performClick()
        compose.waitForIdle()

        compose.onNodeWithTag("deliveryPlanSaveSpinner").assertIsDisplayed()
        compose.onNodeWithTag("deliveryPlanSaveProgress").assertIsDisplayed()
        compose.onNodeWithTag("deliveryPlanFeesField").performScrollTo().assertIsNotEnabled()
        compose.onNodeWithTag("cancelDeliveryPlan").assertIsNotEnabled()
        compose.onNodeWithTag("saveDeliveryPlan").assertIsNotEnabled()
    }

    @Test
    fun failed_save_shows_the_message_and_keeps_the_values() {
        saveMode = SaveMode.FAIL
        start(heuristicPatient)
        openSheet()
        type("deliveryPlanFeesField", "7000 EGP")
        compose.onNodeWithTag("saveDeliveryPlan").performClick()
        compose.waitForIdle()

        compose.onNodeWithTag("deliveryPlanSheet").assertIsDisplayed()
        compose.onNodeWithTag("deliveryPlanSaveMessage").assertIsDisplayed()
        compose.onNodeWithText(
            compose.activity.getString(R.string.delivery_plan_save_failed_title),
            substring = true,
        ).assertIsDisplayed()
        compose.onNodeWithTag("deliveryPlanFeesField").performScrollTo().assertTextContains("7000 EGP", substring = true)
    }

    @Test
    fun narrow_width_and_large_font_show_the_title_labels_and_buttons_in_full() {
        start(heuristicPatient, fontScale = 1.3f)
        openSheet()
        inSheet(compose.activity.getString(R.string.edit_delivery_plan)).assertIsDisplayed()
        inSheet(LABEL_HOSPITAL).assertIsDisplayed().assertTextEquals(LABEL_HOSPITAL)
        inSheet(LABEL_FEES).performScrollTo().assertIsDisplayed().assertTextEquals(LABEL_FEES)
        inSheet(LABEL_PLAN).performScrollTo().assertIsDisplayed().assertTextEquals(LABEL_PLAN)
        inSheet(LABEL_POSTPARTUM).performScrollTo().assertIsDisplayed().assertTextEquals(LABEL_POSTPARTUM)
        compose.onNodeWithTag("cancelDeliveryPlan").assertIsDisplayed()
        compose.onNodeWithTag("saveDeliveryPlan").assertIsDisplayed()
    }

    @Test
    fun label_constants_match_the_card_titles_in_strings() {
        assertEquals("Agreed Delivery Hospital", LABEL_HOSPITAL)
        assertEquals("Agreed Delivery Fees", LABEL_FEES)
        assertEquals("Delivery Plan", LABEL_PLAN)
        assertEquals("Postpartum Note", LABEL_POSTPARTUM)
        assertTrue(composedPatient.obstetricNotes.contains(LABEL_FEES))
    }
}
