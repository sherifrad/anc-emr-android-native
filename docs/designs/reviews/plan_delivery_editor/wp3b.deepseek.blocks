import com.sherifradwan.ancnative.state.SavePhase
import com.sherifradwan.ancnative.state.SaveUiError

@Composable
fun DeliveryPlanSheet(
    draft: PatientDraft,
    savePhase: SavePhase,
    saveError: SaveUiError?,
    onEvent: (AncEvent) -> Unit,
    footer: @Composable () -> Unit = {},
) {
    val values = draft.deliveryPlan
    val touched = values?.touched == true
    val saving = savePhase.blocksEditing()
    val fieldsEnabled = savePhase == SavePhase.IDLE || savePhase == SavePhase.ERROR
    var confirmDiscard by rememberSaveable { mutableStateOf(false) }
    val sheetState = rememberGuardedSheetState(
        dismissAllowed = !saving,
        needsConfirm = touched,
        onNeedsConfirm = { confirmDiscard = true },
    )

    ModalBottomSheet(
        onDismissRequest = {
            when {
                saving -> Unit
                touched -> confirmDiscard = true
                else -> onEvent(AncEvent.CancelEditor)
            }
        },
        sheetState = sheetState,
        modifier = Modifier.testTag("deliveryPlanSheet"),
        skipPartiallyExpanded = true,
    ) {
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .imePadding()
                .padding(bottom = 16.dp),
        ) {
            if (saving) {
                LinearProgressIndicator(
                    modifier = Modifier
                        .fillMaxWidth()
                        .testTag("deliveryPlanSaveProgress"),
                )
            }
            Text(
                text = stringResource(R.string.edit_delivery_plan),
                style = MaterialTheme.typography.titleLarge,
                modifier = Modifier
                    .padding(start = 16.dp, top = 16.dp, end = 16.dp)
                    .semantics { heading() },
            )
            Column(
                modifier = Modifier
                    .weight(1f, fill = false)
                    .verticalScroll(rememberScrollState())
                    .padding(start = 16.dp, top = 12.dp, end = 16.dp, bottom = 12.dp),
                verticalArrangement = Arrangement.spacedBy(12.dp),
            ) {
                SheetSaveMessage(
                    savePhase = savePhase,
                    saveError = saveError,
                    fieldErrorMessage = if (draft.errors.isNotEmpty()) {
                        stringResource(R.string.delivery_plan_profile_invalid)
                    } else {
                        null
                    },
                    failedTitle = stringResource(R.string.delivery_plan_save_failed_title),
                    tag = "deliveryPlanSaveMessage",
                )
                if (values?.rewritesNotes == true) {
                    Text(
                        text = stringResource(R.string.delivery_plan_rewrite_notice),
                        style = MaterialTheme.typography.bodySmall,
                        color = MaterialTheme.colorScheme.onSurfaceVariant,
                        modifier = Modifier.testTag("deliveryPlanRewriteNotice"),
                    )
                }
                DeliveryPlanFieldBlock(
                    label = stringResource(R.string.delivery_hospital_title),
                    value = values?.hospital.orEmpty(),
                    field = DeliveryPlanField.HOSPITAL,
                    tag = "deliveryPlanHospitalField",
                    enabled = fieldsEnabled,
                    minLines = 2,
                    supporting = stringResource(R.string.delivery_hospital_hint),
                    onEvent = onEvent,
                )
                DeliveryPlanFieldBlock(
                    label = stringResource(R.string.delivery_fees_title),
                    value = values?.fees.orEmpty(),
                    field = DeliveryPlanField.FEES,
                    tag = "deliveryPlanFeesField",
                    enabled = fieldsEnabled,
                    minLines = 2,
                    supporting = stringResource(R.string.delivery_fees_hint),
                    onEvent = onEvent,
                )
                DeliveryPlanFieldBlock(
                    label = stringResource(R.string.delivery_plan_title),
                    value = values?.plan.orEmpty(),
                    field = DeliveryPlanField.PLAN,
                    tag = "deliveryPlanPlanField",
                    enabled = fieldsEnabled,
                    minLines = 3,
                    supporting = null,
                    onEvent = onEvent,
                )
                DeliveryPlanFieldBlock(
                    label = stringResource(R.string.delivery_postpartum_title),
                    value = values?.postpartum.orEmpty(),
                    field = DeliveryPlanField.POSTPARTUM,
                    tag = "deliveryPlanPostpartumField",
                    enabled = fieldsEnabled,
                    minLines = 3,
                    supporting = null,
                    onEvent = onEvent,
                )
            }
            SheetCancelSaveRow(
                enabled = fieldsEnabled,
                saving = saving,
                saveEnabled = touched,
                savingLabel = stringResource(R.string.delivery_plan_saving),
                onCancel = {
                    if (touched) confirmDiscard = true else onEvent(AncEvent.CancelEditor)
                },
                onSave = { onEvent(AncEvent.SubmitPatientProfile) },
                cancelTag = "cancelDeliveryPlan",
                saveTag = "saveDeliveryPlan",
                spinnerTag = "deliveryPlanSaveSpinner",
            )
            footer()
        }
    }

    if (confirmDiscard) {
        DiscardChangesDialog(
            onDiscard = {
                confirmDiscard = false
                onEvent(AncEvent.CancelEditor)
            },
            onKeep = { confirmDiscard = false },
            dialogTag = "deliveryPlanDiscardDialog",
            confirmTag = "deliveryPlanDiscardConfirm",
            keepTag = "deliveryPlanDiscardKeep",
        )
    }
}

@Composable
private fun DeliveryPlanFieldBlock(
    label: String,
    value: String,
    field: DeliveryPlanField,
    tag: String,
    enabled: Boolean,
    minLines: Int,
    supporting: String?,
    onEvent: (AncEvent) -> Unit,
) {
    Column(
        modifier = Modifier.fillMaxWidth(),
        verticalArrangement = Arrangement.spacedBy(4.dp),
    ) {
        Text(
            text = label,
            style = MaterialTheme.typography.labelLarge,
            color = MaterialTheme.colorScheme.onSurfaceVariant,
        )
        OutlinedTextField(
            value = value,
            onValueChange = { onEvent(AncEvent.DeliveryPlanFieldChanged(field, it)) },
            modifier = Modifier
                .fillMaxWidth()
                .revealOnFocus()
                .testTag(tag)
                .semantics { contentDescription = label },
            enabled = enabled,
            placeholder = { Text(stringResource(R.string.no_record)) },
            supportingText = supporting?.let { hint ->
                { Text(hint) }
            },
            minLines = minLines,
            keyboardOptions = KeyboardOptions(capitalization = KeyboardCapitalization.Sentences),
        )
    }
}
