enum class PatientEditorKind { PROFILE, HISTORIES, PREGNANCY, STATUS }

enum class DeliveryPlanField { HOSPITAL, FEES, PLAN, POSTPARTUM }

data class DeliveryPlanFields(
    val hospital: String,
    val fees: String,
    val plan: String,
    val postpartum: String,
    val openedNotes: String,
    val rewritesNotes: Boolean,
) {
    fun with(field: DeliveryPlanField, value: String): DeliveryPlanFields = when (field) {
        DeliveryPlanField.HOSPITAL -> copy(hospital = value)
        DeliveryPlanField.FEES -> copy(fees = value)
        DeliveryPlanField.PLAN -> copy(plan = value)
        DeliveryPlanField.POSTPARTUM -> copy(postpartum = value)
    }

    internal fun toSections(): com.sherifradwan.ancnative.model.DeliveryNoteSections =
        com.sherifradwan.ancnative.model.DeliveryNoteSections(
            hospital = hospital.ifBlank { null },
            fees = fees.ifBlank { null },
            plan = plan.ifBlank { null },
            postpartum = postpartum.ifBlank { null },
        )

    // Judged on the composed text, so a character typed and deleted is not a change.
    val touched: Boolean get() = composed() != openedNotes

    private fun composed(): String = com.sherifradwan.ancnative.model.composeDeliveryNotes(toSections())
}

