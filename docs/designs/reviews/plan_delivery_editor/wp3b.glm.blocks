package com.sherifradwan.ancnative

import android.os.SystemClock
import androidx.compose.foundation.layout.Box
import androidx.compose.foundation.layout.widthIn
import androidx.compose.runtime.Composable
import androidx.compose.runtime.CompositionLocalProvider
import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.setValue
import androidx.compose.ui.Modifier
import androidx.compose.ui.platform.LocalDensity
import androidx.compose.ui.platform.testTag
import androidx.compose.ui.test.assertIsDisplayed
import androidx.compose.ui.test.assertIsEnabled
import androidx.compose.ui.test.assertIsNotEnabled
import androidx.compose.ui.test.assertIsSelected
import androidx.compose.ui.test.assertTextEquals
import androidx.compose.ui.test.hasAnyAncestor
import androidx.compose.ui.test.hasTestTag
import androidx.compose.ui.test.hasText
import androidx.compose.ui.test.junit4.createAndroidComposeRule
import androidx.compose.ui.test.performClick
import androidx.compose.ui.test.performScrollTo
import androidx.compose.ui.test.performTextReplacement
import androidx.compose.ui.unit.Density
import androidx.compose.ui.unit.dp
import androidx.test.ext.junit.runners.AndroidJUnit4
import com.sherifradwan.ancnative.model.DemoFixtures
import com.sherifradwan.ancnative.model.DemoPatient
import com.sherifradwan.ancnative.model.composeDeliveryNotes
import com.sherifradwan.ancnative.model.parseDeliveryNotes
import com.sherifradwan.ancnative.state.AncEvent
import com.sherifradwan.ancnative.state.AncReducer
import com.sherifradwan.ancnative.state.AncRoute
import com.sherifradwan.ancnative.state.AncState
import com.sherifradwan.ancnative.state.PatientEditorKind
import com.sherifradwan.ancnative.state.PendingSaveToken
import com.sherifradwan.ancnative.state.SavedNotice
import com.sherifradwan.ancnative.state.SaveUiError
import com.sherifradwan.ancnative.state.WorkspaceSection
import com.sherifradwan.ancnative.storage.PatientCommandPreparation
import com.sherifradwan.ancnative.storage.SavePatientProfileCommand
import com.sherifradwan.ancnative.storage.VaultState
import com.sherifradwan.ancnative.ui.AncApp
import com.sherifradwan.ancnative.ui.AncTheme
import com.sherifradwan.ancnative.ui.patienthub.PatientHubTab
import org.junit.Assert.assertEquals
import org.junit.Assert.assertFalse
import org.junit.Assert.assertTrue
import org.junit.Rule
import org.junit.Test
import org.junit.runner.RunWith
import java.time.LocalDate
import java.util.UUID

/**
 * The Plan tab with the delivery plan sheet, mounted through the real AncApp and reducer. Profile saves go through the
 * real [SavePatientProfileCommand.prepare]; a small in-memory commit applies the command the way the view model reports
 * a store result.
 */
@RunWith(AndroidJUnit4::class)
class DeliveryPlanSheetTest {
    @get:Rule
    val compose = createAndroidComposeRule<MainActivity>()

    private var state by mutableStateOf(AncState(patients = emptyList()))
    // JUnit makes a new instance for every test, so this is read once per test.
    private val today = LocalDate.now().toString()
    private val planTab get() = AncRoute.Workspace(patient.id, WorkspaceSection.DELIVERY)

    /** Every profile command the store was given, in order. */
    private val submitted = mutableListOf<SavePatientProfileCommand>()
    private var holdSaves = false
    private var rejectWith: SaveUiError? = null
    private var held: Pair<SavePatientProfileCommand, PendingSaveToken>? = null

    // The fixture notes are heuristic (not composed), so the sheet opens with the rewrite notice showing.
    private val patient = DemoFixtures.patients.first().copy(status = "active")

    private fun str(resId: Int) = compose.activity.getString(resId)

    private fun onEvent(event: AncEvent) {
        state = AncReducer.reduce(state, event)
        when (event) {
            AncEvent.SubmitPatientProfile -> submitProfile()
            else -> Unit
        }
    }

    /** As the view model does: prepare the profile command, then commit it (or hold it, or reject it). */
    private fun submitProfile() {
        when (val prepared = SavePatientProfileCommand.prepare(state, UUID.randomUUID().toString(), today)) {
            is PatientCommandPreparation.Rejected -> state = AncReducer.reduce(
                state,
                AncEvent.PatientValidationFailed(PatientEditorKind.PROFILE, prepared.errors),
            )
            is PatientCommandPreparation.Ready -> {
                val command = prepared.command
                val token = PendingSaveToken(command.operationUuid, command.editorSessionId)
                state = AncReducer.reduce(state, AncEvent.SaveStarted(token))
                submitted += command
                if (holdSaves) held = command to token else finish(command, token)
            }
        }
    }

    private fun finish(command: SavePatientProfileCommand, token: PendingSaveToken) {
        val error = rejectWith
        state = if (error != null) {
            AncReducer.reduce(state, AncEvent.SaveFailed(token, error, unresolved = false))
        } else {
            AncReducer.reduce(
                state,
                AncEvent.RecordCommitted(
                    token,
                    committed(command),
                    planTab,
                    SavedNotice.PATIENT,
                    SystemClock.elapsedRealtime(),
                ),
            )
        }
    }

    private fun releaseHeldSave() {
        val (command, token) = held!!
        held = null
        compose.runOnIdle { finish(command, token) }
        compose.waitForIdle()
    }

    private fun committed(command: SavePatientProfileCommand) = state.patients.map { p ->
        if (p.id != command.patientId) p else p.copy(obstetricNotes = command.obstetricNotes, revision = p.revision + 1)
    }

    /** Mounts the app on the Plan tab. With [fontScale] the screen is also held to at most 360 dp wide. */
    private fun host(patientUnderTest: DemoPatient = patient, fontScale: Float? = null) {
        state = AncState(
            patients = listOf(patientUnderTest),
            vaultState = VaultState.Unlocked(sessionEpoch = 7101L),
            route = planTab,
        )
        compose.activityRule.scenario.onActivity { activity ->
            activity.setContent {
                val app = @Composable {
                    AncTheme {
                        AncApp(
                            state = state,
                            onEvent = ::onEvent,
                            onStartVisit = { _, _ -> },
                            onSaveVisit = {},
                            onInitialize = {},
                            onUnlock = {},
                            onLock = {},
                            onRetryStorage = {},
                        )
                    }
                }
                if (fontScale == null) {
                    app()
                } else {
                    val base = LocalDensity.current
                    CompositionLocalProvider(LocalDensity provides Density(base.density, fontScale)) {
                        Box(Modifier.widthIn(max = 360.dp).testTag(NARROW_HOST)) { app() }
                    }
                }
            }
        }
        compose.waitForIdle()
    }

    private fun node(tag: String) = compose.onNodeWithTag(tag, useUnmergedTree = true)
    private fun exists(tag: String) = compose.onAllNodes(hasTestTag(tag), useUnmergedTree = true).fetchSemanticsNodes().isNotEmpty()
    private fun click(tag: String) {
        node(tag).performClick()
        compose.waitForIdle()
    }

    /** Opens the delivery plan sheet from the Plan tab and waits until it is shown. */
    private fun openSheet() {
        compose.scrollHubTabTo(PatientHubTab.PLAN, hasTestTag("editDeliveryPlan"))
        click("editDeliveryPlan")
        node("deliveryPlanSheet").assertIsDisplayed()
    }

    /** Replaces the whole fees value, so the assertions do not depend on the parser's seed text. */
    private fun typeFees(text: String) {
        node("deliveryPlanFeesField").performTextReplacement(text)
        compose.waitForIdle()
    }

    /** Text inside the sheet only; the card behind the scrim shows the same box titles and would match twice. */
    private fun sheetText(text: String) =
        compose.onNode(
            hasText(text) and hasAnyAncestor(hasTestTag("deliveryPlanSheet")),
            useUnmergedTree = true,
        )

    @Test
    fun labelConstantsMatchCardTitlesInStringsXml() {
        assertEquals(LABEL_HOSPITAL, str(R.string.delivery_hospital_title))
        assertEquals(LABEL_FEES, str(R.string.delivery_fees_title))
        assertEquals(LABEL_PLAN, str(R.string.delivery_plan_title))
        assertEquals(LABEL_POSTPARTUM, str(R.string.delivery_postpartum_title))
    }

    @Test
    fun openingTheSheetShowsItOverThePlanTabWithoutChangingTheRoute() {
        host()
        openSheet()
        node("planTabContent").assertExists()
        assertTrue(state.route is AncRoute.Workspace)
    }

    @Test
    fun saveStaysDisabledUntilAFieldChanges() {
        host()
        openSheet()
        node("saveDeliveryPlan").assertIsNotEnabled()
        typeFees("5000 EGP")
        node("saveDeliveryPlan").assertIsEnabled()
    }

    @Test
    fun rewriteNoticeShowsForHeuristicNotesAndNotForComposedNotes() {
        host()
        openSheet()
        node("deliveryPlanRewriteNotice").assertIsDisplayed()
        click("cancelDeliveryPlan")

        host(patientUnderTest = patient.copy(obstetricNotes = composeDeliveryNotes(parseDeliveryNotes(patient.obstetricNotes))))
        openSheet()
        assertFalse(exists("deliveryPlanRewriteNotice"))
    }

    @Test
    fun editingFeesAndSavingCommitsAndStaysOnThePlanTab() {
        host()
        openSheet()
        typeFees("5000 EGP")
        click("saveDeliveryPlan")
        assertFalse(exists("deliveryPlanSheet"))
        compose.scrollHubTabTo(PatientHubTab.PLAN, hasText("5000 EGP"))
        compose.onNodeWithText("5000 EGP").assertIsDisplayed()
        node("tab-plan").assertIsSelected()
    }

    @Test
    fun untouchedCancelClosesAtOnceAndTouchedCancelAsksFirst() {
        host()
        openSheet()
        click("cancelDeliveryPlan")
        assertFalse(exists("deliveryPlanSheet"))

        openSheet()
        typeFees("5000 EGP")
        click("cancelDeliveryPlan")
        node("deliveryPlanDiscardDialog").assertIsDisplayed()
        click("deliveryPlanDiscardKeep")
        node("deliveryPlanSheet").assertIsDisplayed()
        click("cancelDeliveryPlan")
        click("deliveryPlanDiscardConfirm")
        assertFalse(exists("deliveryPlanSheet"))
        assertEquals(patient.obstetricNotes, state.patient(patient.id)!!.obstetricNotes)
    }

    @Test
    fun whileSavingFieldsCancelAndSaveAreDisabledAndTheSpinnerShows() {
        host()
        openSheet()
        typeFees("5000 EGP")
        holdSaves = true
        click("saveDeliveryPlan")
        node("deliveryPlanSaveProgress").assertIsDisplayed()
        node("deliveryPlanSaveSpinner").assertIsDisplayed()
        node("deliveryPlanFeesField").assertIsNotEnabled()
        node("cancelDeliveryPlan").assertIsNotEnabled()
        node("saveDeliveryPlan").assertIsNotEnabled()
        holdSaves = false
        releaseHeldSave()
        assertFalse(exists("deliveryPlanSheet"))
    }

    @Test
    fun failedSaveShowsTheErrorAndKeepsTheValues() {
        host()
        openSheet()
        typeFees("5000 EGP")
        rejectWith = SaveUiError.STORAGE_ERROR
        click("saveDeliveryPlan")
        node("deliveryPlanSaveMessage").assertIsDisplayed()
        compose.onNodeWithText(str(R.string.save_storage_error)).assertIsDisplayed()
        node("deliveryPlanFeesField").assertTextEquals("5000 EGP")
        rejectWith = null
    }

    @Test
    fun titleLabelsAndButtonsShowInFullAt360dpWithLargeFont() {
        host(fontScale = 1.3f)
        openSheet()
        sheetText(str(R.string.edit_delivery_plan)).assertIsDisplayed()
        sheetText(LABEL_HOSPITAL).performScrollTo().assertIsDisplayed()
        sheetText(LABEL_FEES).performScrollTo().assertIsDisplayed()
        sheetText(LABEL_PLAN).performScrollTo().assertIsDisplayed()
        sheetText(LABEL_POSTPARTUM).performScrollTo().assertIsDisplayed()
        node("cancelDeliveryPlan").assertIsDisplayed()
        node("saveDeliveryPlan").assertIsDisplayed()
    }

    private companion object {
        const val LABEL_HOSPITAL = "Agreed Delivery Hospital"
        const val LABEL_FEES = "Agreed Delivery Fees"
        const val LABEL_PLAN = "Delivery Plan"
        const val LABEL_POSTPARTUM = "Postpartum Note"
        const val NARROW_HOST = "deliveryNarrowHost"
    }
}
