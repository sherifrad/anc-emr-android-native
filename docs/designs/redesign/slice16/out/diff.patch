+                style = RecordType.Action,
+                maxLines = 2,
+                textAlign = TextAlign.Center,
+                color = when {
+                    selected -> MaterialTheme.colorScheme.onPrimary
+                    enabled -> MaterialTheme.colorScheme.onSurface
+                    else -> MaterialTheme.colorScheme.onSurfaceVariant
+                },
+            )
+        }
+    }
